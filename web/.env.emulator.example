# Copy to .env.emulator.local to run `npm run dev` against the local Firebase emulators
# (see docs/development.md). These values are fake on purpose.
VITE_FIREBASE_EMULATOR=1
VITE_FIREBASE_API_KEY=fake-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nodemon.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-nodemon-default-rtdb
VITE_FIREBASE_PROJECT_ID=demo-nodemon
