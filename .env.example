# Public URL users and connectors use to reach the server (use https in production).
BASE_URL=http://localhost:8080
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated Google emails allowed to log in. Empty = any Google account (each sees only its own computers).
ALLOWED_EMAILS=
